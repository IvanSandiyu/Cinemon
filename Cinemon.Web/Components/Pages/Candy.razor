@page "/candy"
@rendermode InteractiveServer

@using Cinemon.Web.Models.DTOs
@using Cinemon.Web.Services

@inject CandyApiService CandyService
@inject CarritoService Carrito

<PageTitle>Candy | Cinemon</PageTitle>

<div class="candy-page">

    <div class="candy-header">
        <span class="cinemon-kicker">Candy</span>
        <h1 class="candy-title">Candy</h1>
        <p class="candy-subtitle">
            Pochoclos, gaseosas y combos. Se retiran en el mostrador antes de entrar a la sala.
        </p>
    </div>

    @if (CantidadEnCarrito > 0) {
        <div class="candy-carrito-barra">
            <span class="candy-carrito-info">
                <span class="material-icons">shopping_bag</span>
                @CantidadEnCarrito @(CantidadEnCarrito == 1 ? "producto" : "productos") en tu carrito
            </span>

            <strong class="candy-carrito-total">$@Carrito.Total.ToString("#,##0")</strong>

            <a href="/carrito" class="candy-carrito-ir">Ver carrito</a>
        </div>
    }

    <div class="candy-filtros">
        @foreach (var filtro in _filtros) {
            var actual = filtro;

            <button type="button"
                    class="candy-filtro @(_filtroActual == actual ? "activo" : "")"
                    @onclick="() => _filtroActual = actual">
                @NombreFiltro(actual)
            </button>
        }
    </div>

    @if (_mensaje is not null) {
        <div class="candy-toast" role="status">
            <span class="material-icons">check_circle</span>
            <span>@_mensaje</span>
            <a href="/carrito">Ver carrito</a>
        </div>
    }

    @if (_cargando) {
        <div class="d-flex justify-content-center py-5">
            <RadzenProgressBarCircular Indeterminate="true" />
        </div>
    } else if (_error is not null) {
        <RadzenAlert AlertStyle="AlertStyle.Danger">@_error</RadzenAlert>
    } else if (ProductosVisibles.Count == 0) {
        <div class="candy-vacio">
            <span class="material-icons">fastfood</span>
            <h3>No hay productos en esta categoría</h3>
            <p>Probá con otro filtro.</p>
        </div>
    } else {
        <div class="candy-grid">

            @foreach (var producto in ProductosVisibles) {
                <article class="candy-tarjeta">

                    <div class="candy-tarjeta-head">
                        <span class="candy-ico candy-ico-@ClaseCategoria(producto.Categoria)">
                            @if (producto.Categoria == (int)FiltroCandy.Pochoclo) {
                                <svg class="candy-ico-svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                                    <path fill="currentColor" d="M7,22H4.75C4.75,22 4,22 3.81,20.65L2.04,3.81L2,3.5C2,2.67 2.9,2 4,2C5.1,2 6,2.67 6,3.5C6,2.67 6.9,2 8,2C9.1,2 10,2.67 10,3.5C10,2.67 10.9,2 12,2C13.09,2 14,2.66 14,3.5V3.5C14,2.67 14.9,2 16,2C17.1,2 18,2.67 18,3.5C18,2.67 18.9,2 20,2C21.1,2 22,2.67 22,3.5L21.96,3.81L20.19,20.65C20,22 19.25,22 19.25,22H17L16.5,22H13.75L10.25,22H7.5L7,22M17.85,4.93C17.55,4.39 16.84,4 16,4C15.19,4 14.36,4.36 14,4.87L13.78,20H16.66L17.85,4.93M10,4.87C9.64,4.36 8.81,4 8,4C7.16,4 6.45,4.39 6.15,4.93L7.34,20H10.22L10,4.87Z" />
                                </svg>
                            } else {
                                <span class="material-icons">@IconoCategoria(producto.Categoria)</span>
                            }
                        </span>

                        <span class="candy-categoria">@NombreCategoria(producto.Categoria)</span>
                    </div>

                    <h3 class="candy-nombre">@producto.Nombre</h3>

                    @if (!string.IsNullOrWhiteSpace(producto.Descripcion)) {
                        <p class="candy-desc">@producto.Descripcion</p>
                    }

                    @if (producto.Componentes.Count > 0) {
                        <ul class="candy-componentes">
                            @foreach (var componente in producto.Componentes) {
                                <li>
                                    <span class="material-icons">check</span>
                                    <span>@componente.Cantidad × @componente.Nombre</span>
                                </li>
                            }
                        </ul>
                    }

                    <div class="candy-pie">
                        <strong class="candy-precio">$@producto.Precio.ToString("#,##0")</strong>

                        <button type="button"
                                class="candy-agregar"
                                @onclick="() => Agregar(producto)">
                            <span class="material-icons">add_shopping_cart</span>
                            Agregar
                        </button>
                    </div>

                </article>
            }

        </div>
    }

</div>

@code {

    private enum FiltroCandy
    {
        Todos,
        Pochoclo,
        Gaseosa,
        Combo,
        Extra
    }

    private static readonly FiltroCandy[] _filtros =
    [
        FiltroCandy.Todos,
        FiltroCandy.Pochoclo,
        FiltroCandy.Gaseosa,
        FiltroCandy.Combo,
        FiltroCandy.Extra
    ];

    private IReadOnlyCollection<ProductoCandyDto> _productos = [];
    private bool _cargando = true;
    private string? _error;
    private string? _mensaje;

    private FiltroCandy _filtroActual = FiltroCandy.Todos;
    private int _secuenciaMensaje;

    private int CantidadEnCarrito => Carrito.CantidadTotal;

    private IReadOnlyCollection<ProductoCandyDto> ProductosVisibles =>
        _filtroActual == FiltroCandy.Todos
            ? _productos
            : _productos.Where(x => x.Categoria == (int)_filtroActual).ToList();

    protected override async Task OnInitializedAsync()
    {
        try {
            await Carrito.CargarAsync();

            _productos = await CandyService.ObtenerDisponiblesAsync();
        } catch {
            _error = "No se pudieron cargar los productos de Candy.";
        } finally {
            _cargando = false;
        }
    }

    private async Task Agregar(ProductoCandyDto producto)
    {
        await Carrito.AgregarAsync(new CarritoItemDto(
            producto.Id,
            producto.Nombre,
            producto.Descripcion,
            producto.Precio,
            producto.Categoria,
            1));

        await MostrarMensaje($"Se agregó \"{producto.Nombre}\" al carrito.");
    }

    private async Task MostrarMensaje(string mensaje)
    {
        var secuencia = ++_secuenciaMensaje;

        _mensaje = mensaje;

        await InvokeAsync(StateHasChanged);

        await Task.Delay(3000);

        if (secuencia != _secuenciaMensaje)
            return;

        _mensaje = null;

        await InvokeAsync(StateHasChanged);
    }

    private static string NombreFiltro(FiltroCandy filtro) => filtro switch
    {
        FiltroCandy.Pochoclo => "Pochoclos",
        FiltroCandy.Gaseosa => "Gaseosas",
        FiltroCandy.Combo => "Combos",
        FiltroCandy.Extra => "Extras",
        _ => "Todos"
    };

    private static string NombreCategoria(int categoria) => categoria switch
    {
        1 => "Pochoclo",
        2 => "Gaseosa",
        3 => "Combo",
        4 => "Extra",
        _ => "Candy"
    };

    private static string IconoCategoria(int categoria) => categoria switch
    {
        1 => "popcorn",
        2 => "local_drink",
        3 => "fastfood",
        4 => "restaurant",
        _ => "fastfood"
    };

    private static string ClaseCategoria(int categoria) => categoria switch
    {
        1 => "pochoclo",
        2 => "gaseosa",
        3 => "combo",
        4 => "extra",
        _ => "extra"
    };
}
