@page "/cartelera"
@using Cinemon.Web.Models.DTOs
@using Cinemon.Web.Services
@inject PeliculaApiService PeliculaService

<PageTitle>Cartelera | Cinemon</PageTitle>

<div class="cartelera-head mb-4">
    <h5 class="cinemon-kicker">En cartelera</h5>
    @if (!_cargando && _peliculas.Count > 0)
    {
        <span class="cinemon-count">@_peliculas.Count películas</span>
    }
</div>

@if (_cargando)
{
    <div class="d-flex justify-content-center mt-4">
        <RadzenProgressBarCircular Indeterminate="true" />
    </div>
}
else if (_peliculas.Count == 0)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">
        No hay películas disponibles actualmente.
    </RadzenAlert>
}
else
{
    <div class="row g-3">

        @foreach (var (pelicula, index) in _peliculas.Select((p, i) => (p, i)))
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="cinemon-movie-card cartelera-item"
                     style="@($"animation-delay: {index * 60}ms;")">

                    <div class="movie-poster-container">
                        <img class="movie-poster-img"
                             src="@pelicula.PosterUrl"
                             alt="@pelicula.Titulo"
                             loading="lazy" />
                    </div>

                    <div class="movie-info">
                        <h6 class="cinemon-card-title">@pelicula.Titulo</h6>

                        <div class="movie-meta">
                            <span class="cinemon-genres">@(string.Join(" · ", pelicula.Generos))</span>
                            <span class="cinemon-divider"></span>
                            <span class="cinemon-duration">@pelicula.Duracion min</span>
                        </div>
                    </div>

                    <div class="movie-actions">
                        <RadzenLink Path="@($"/peliculas/{pelicula.Id}")"
                                    class="cinemon-link">Ver funciones</RadzenLink>
                    </div>

                </div>
            </div>
        }

    </div>
}

@code {
    private IReadOnlyCollection<PeliculaDto> _peliculas = [];
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _peliculas = await PeliculaService.ObtenerTodasAsync();
        }
        finally
        {
            _cargando = false;
        }
    }
}