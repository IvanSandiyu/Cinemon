@page "/admin/funciones/nueva"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using Cinemon.Web.Models.DTOs
@using Cinemon.Web.Models.DTOs.Requests
@using Cinemon.Web.Services

@inject FuncionApiService FuncionService
@inject PeliculaApiService PeliculaService
@inject SalaApiService SalaService
@inject NavigationManager Navigation

<PageTitle>Nueva función | Admin | Cinemon</PageTitle>

<AdminGuard>
<div class="admin-page">

    <div class="admin-header">

        <span class="cinemon-kicker">
            Administración
        </span>

        <h1 class="admin-title">
            Nueva función
        </h1>

        <p class="admin-subtitle">
            Programá un horario, sala y precio para una película.
        </p>

    </div>

    @if (_cargando) {
        <div class="d-flex justify-content-center py-5">
            <RadzenProgressBarCircular Indeterminate="true" />
        </div>
    } else {

        <div class="admin-create-layout">

            <section class="admin-form-section">

                <div class="admin-form-section-header">

                    <div>
                        <h2>Datos de la función</h2>

                        <p>
                            Elegí la película, la sala y el horario de inicio.
                        </p>
                    </div>

                </div>

                <div class="admin-form">

                    <div class="admin-form-field">

                        <label>
                            Película
                        </label>

                        <select @bind="_peliculaId">
                            <option value="0">
                                Seleccionar película...
                            </option>

                            @foreach (var pelicula in _peliculas) {
                                <option value="@pelicula.Id">
                                    @pelicula.Titulo
                                    (@pelicula.ClasificacionEdad · @pelicula.Duracion min)
                                </option>
                            }
                        </select>

                        @if (_peliculaSeleccionada is not null) {
                            <span class="admin-field-hint">
                                Cartelera: el fin de la función se calculará con la duración de
                                @_peliculaSeleccionada.Duracion minutos.
                            </span>
                        }

                    </div>

                    <div class="admin-form-row">

                        <div class="admin-form-field">

                            <label>
                                Sala
                            </label>

                            <select @bind="_salaId">
                                <option value="0">
                                    Seleccionar sala...
                                </option>

                                @foreach (var sala in _salas) {
                                    <option value="@sala.Id">
                                        Sala @sala.Numero —
                                        @(sala.TipoSala == "Imax" ? "IMAX" : "Estándar")
                                        (@sala.CantidadButacas butacas)
                                    </option>
                                }
                            </select>

                        </div>

                        <div class="admin-form-field">

                            <label>
                                Fecha
                            </label>

                            <input type="date"
                                   @bind="_fecha" />

                        </div>

                        <div class="admin-form-field">

                            <label>
                                Hora
                            </label>

                            <input type="time"
                                   @bind="_hora" />

                        </div>

                    </div>

                    <div class="admin-form-row">

                        <div class="admin-form-field">

                            <label>
                                Precio por entrada ($)
                            </label>

                            <input type="number"
                                   min="1"
                                   step="0.01"
                                   @bind="_precio"
                                   placeholder="Ej: 6500" />

                        </div>

                        <div class="admin-form-field">

                            <label>
                                Idioma
                            </label>

                            <div class="admin-segmented">

                                <button type="button"
                                        class="@(_idioma == 1 ? "selected" : "")"
                                        @onclick="() => _idioma = 1">
                                    Español
                                </button>

                                <button type="button"
                                        class="@(_idioma == 2 ? "selected" : "")"
                                        @onclick="() => _idioma = 2">
                                    Subtitulada
                                </button>

                            </div>

                        </div>

                        <div class="admin-form-field">

                            <label>
                                Formato
                            </label>

                            <div class="admin-segmented">

                                <button type="button"
                                        class="@(_formato == 1 ? "selected" : "")"
                                        @onclick="() => _formato = 1">
                                    2D
                                </button>

                                <button type="button"
                                        class="@(_formato == 2 ? "selected" : "")"
                                        @onclick="() => _formato = 2">
                                    3D
                                </button>

                            </div>

                        </div>

                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(_error)) {
                    <div class="admin-form-error">
                        @_error
                    </div>
                }

                <div class="admin-form-actions">

                    <RadzenButton Text="Cancelar"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="Cancelar"
                                  class="admin-cancel-button" />

                    <RadzenButton Text="Guardar función"
                                  Icon="save"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="Guardar"
                                  Disabled="@_guardando" />

                </div>

            </section>

        </div>

    }

</div>
</AdminGuard>

@code {

    private IReadOnlyCollection<PeliculaDto> _peliculas = [];
    private IReadOnlyCollection<SalaDto> _salas = [];

    private bool _cargando = true;
    private bool _guardando;

    private string? _error;

    private int _peliculaId;
    private int _salaId;
    private DateTime _fecha = DateTime.Today;
    private TimeOnly _hora = new(20, 0);
    private int _idioma = 1;
    private int _formato = 1;
    private decimal _precio;

    private PeliculaDto? _peliculaSeleccionada =>
        _peliculas.FirstOrDefault(p => p.Id == _peliculaId);

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        _cargando = true;
        _error = null;

        try {
            _peliculas = await PeliculaService.ObtenerTodasAsync();
            _salas = await SalaService.ObtenerTodasAsync();

            var proxima = ObtenerProximaMediaHora();
            _fecha = proxima.Date;
            _hora = TimeOnly.FromDateTime(proxima);
        } catch {
            _error = "No se pudieron cargar las películas y las salas.";
        } finally {
            _cargando = false;
        }
    }

    private async Task Guardar()
    {
        _error = null;

        if (_peliculaId <= 0) {
            _error = "Seleccioná una película.";
            return;
        }

        if (_salaId <= 0) {
            _error = "Seleccioná una sala.";
            return;
        }

        var inicio = _fecha.Add(_hora.ToTimeSpan());

        if (inicio <= DateTime.Now) {
            _error = "La fecha y hora debe ser en el futuro.";
            return;
        }

        if (_precio <= 0) {
            _error = "El precio debe ser mayor a 0.";
            return;
        }

        var sala = _salas.FirstOrDefault(s => s.Id == _salaId);

        if (sala?.TipoSala == "Imax" && _formato == 2) {
            _error = "Una sala IMAX no puede tener funciones 3D.";
            return;
        }

        _guardando = true;

        try {
            var request = new CrearFuncionRequest(
                _peliculaId,
                _salaId,
                inicio,
                _idioma,
                _formato,
                _precio);

            var (funcionId, error) =
                await FuncionService.CrearAsync(request);

            if (error is not null) {
                _error = ObtenerMensajeError(error);
                return;
            }

            Navigation.NavigateTo("/admin/funciones");
        } catch (Exception) {
            _error = "No se pudo guardar la función.";
        } finally {
            _guardando = false;
        }
    }

    private string ObtenerMensajeError(string respuesta)
    {
        try {
            var problema = System.Text.Json.JsonSerializer.Deserialize<
                ApiProblemDetails>(respuesta);

            if (problema is null || problema.Errors is null)
                return problema?.Detail ??
                    problema?.Title ?? "No se pudo guardar la función.";

            var mensajes = problema.Errors
                .SelectMany(x => x.Value)
                .Where(x => !string.IsNullOrWhiteSpace(x));

            if (mensajes.Any()) {
                return string.Join(" ", mensajes);
            }
        } catch {
        }

        return "No se pudo guardar la función.";
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/admin/funciones");
    }

    private static DateTime ObtenerProximaMediaHora()
    {
        var ahora = DateTime.Now;

        var minutos = ahora.Minute >= 30 ? 60 : 30;

        return new DateTime(
            ahora.Year,
            ahora.Month,
            ahora.Day,
            ahora.Hour,
            0,
            0)
            .AddMinutes(minutos);
    }

    private sealed record ApiProblemDetails(
        string? Title,
        string? Detail,
        Dictionary<string, string[]>? Errors);
}