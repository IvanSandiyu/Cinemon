@page "/admin/promociones"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using System.Globalization
@using Cinemon.Web.Models.DTOs
@using Cinemon.Web.Services

@inject PromocionApiService PromocionService

<PageTitle>Promociones | Admin | Cinemon</PageTitle>

<AdminGuard>
<div class="admin-page">

    <div class="admin-header admin-section-header">
        <div>
            <span class="cinemon-kicker">Administración</span>

            <h1 class="admin-title">
                Promociones
            </h1>

            <p class="admin-subtitle">
                El descuento se aplica sobre el precio de la entrada del formato de la función.
                Si varias promociones aplican el mismo día, gana la que deja el total más bajo.
            </p>
        </div>
    </div>

    @if (_cargando) {
        <div class="d-flex justify-content-center py-5">
            <RadzenProgressBarCircular Indeterminate="true" />
        </div>
    } else {

        <section class="admin-form-section">

            <div class="admin-form-section-header">
                <div>
                    <h2>@( _editando is null ? "Nueva promoción" : "Editar promoción" )</h2>
                    <p>
                        Tipo NxM = pagás N entradas y las M siguientes salen gratis.
                        Tipo Porcentaje = descuento directo sobre el precio.
                    </p>
                </div>
            </div>

            <div class="admin-form">

                <div class="admin-form-field">
                    <label>Nombre</label>

                    <input type="text"
                           placeholder="Ej: 2x1 Lunes a Miércoles"
                           value="@_nombre"
                           @onchange="e => _nombre = e.Value?.ToString() ?? string.Empty" />
                </div>

                <div class="admin-form-field">
                    <label>Tipo</label>

                    <div class="admin-segmented">
                        <button type="button"
                                class="@( _tipo == Tipo.NxM ? "selected" : "")"
                                @onclick="() => _tipo = Tipo.NxM">
                            NxM
                        </button>

                        <button type="button"
                                class="@( _tipo == Tipo.Porcentaje ? "selected" : "")"
                                @onclick="() => _tipo = Tipo.Porcentaje">
                            Porcentaje
                        </button>
                    </div>
                </div>

                @if (_tipo == Tipo.NxM) {
                    <div class="admin-form-row">

                        <div class="admin-form-field">
                            <label>Cantidad pagadas</label>

                            <input type="number" min="1" step="1"
                                   value="@_cantidadPagadas"
                                   @onchange="e => _cantidadPagadas = ParsearEntero(e.Value)" />

                            <span class="admin-field-hint">
                                Se cobran esta cantidad de entradas por grupo.
                            </span>
                        </div>

                        <div class="admin-form-field">
                            <label>Cantidad gratis</label>

                            <input type="number" min="1" step="1"
                                   value="@_cantidadGratis"
                                   @onchange="e => _cantidadGratis = ParsearEntero(e.Value)" />

                            <span class="admin-field-hint">
                                Esta cantidad sale gratis por cada grupo completo.
                            </span>
                        </div>

                    </div>
                }
                else {
                    <div class="admin-form-row admin-form-row-precio">

                        <div class="admin-form-field">
                            <label>Porcentaje de descuento</label>

                            <input type="number" min="1" max="100" step="0.01"
                                   value="@_porcentaje"
                                   @onchange="e => _porcentaje = ParsearDecimal(e.Value)" />

                            <span class="admin-field-hint">
                                Se aplica sobre el subtotal de la reserva.
                            </span>
                        </div>

                    </div>
                }

                <div class="admin-form-row">

                    <div class="admin-form-field">
                        <label>Válida desde</label>

                        <input type="date"
                               value="@_fechaDesde.ToString("yyyy-MM-dd")"
                               @onchange="e => CambiarFechaDesde(e.Value?.ToString())" />
                    </div>

                    <div class="admin-form-field">
                        <label>Válida hasta</label>

                        <input type="date"
                               value="@_fechaHasta.ToString("yyyy-MM-dd")"
                               @onchange="e => CambiarFechaHasta(e.Value?.ToString())" />
                    </div>

                </div>

                <div class="admin-form-field">
                    <label>Días de la semana</label>

                    <div class="admin-dias">
                        @foreach (var dia in TodosLosDias) {
                            <button type="button"
                                    class="@( _dias.Contains(dia.Value ) ? "selected" : "")"
                                    @onclick="() => AlternarDia(dia.Value)">
                                @dia.Label
                            </button>
                        }
                    </div>

                    <span class="admin-field-hint">
                        @( _dias.Count == 0
                                ? "No hay días seleccionados: la promoción nunca aplica."
                                : $"{_dias.Count} día(s) seleccionado(s)." )
                    </span>
                </div>

                @if (_errorFormulario is not null) {
                    <p class="admin-form-error">@_errorFormulario</p>
                }

                <div class="admin-form-actions">

                    @if (_editando is not null) {
                        <RadzenButton Text="Cancelar"
                                      class="admin-cancel-button"
                                      Click="LimpiarFormulario" />
                    }

                    <RadzenButton Icon="save"
                                  Text="Guardar"
                                  Disabled="@_guardando"
                                  Click="Guardar" />

                </div>

            </div>

        </section>

        <section class="admin-form-section admin-form-section-separada">

            <div class="admin-form-section-header">
                <div>
                    <h2>Promociones cargadas</h2>
                    <p>@_promociones.Count en total</p>
                </div>
            </div>

            @if (_error is not null) {
                <p class="admin-form-error">@_error</p>
            }
            else if (_promociones.Count == 0) {
                <div class="admin-empty">
                    <span class="material-icons">card_giftcard</span>

                    <h3>No hay promociones cargadas</h3>

                    <p>
                        Creá la primera desde el formulario de arriba.
                    </p>
                </div>
            }
            else {
                <div class="admin-table-wrap">

                    <table class="admin-table">

                        <thead>
                            <tr>
                                <th class="col-promocion">Promoción</th>
                                <th>Tipo</th>
                                <th>Beneficio</th>
                                <th class="col-dias">Días</th>
                                <th>Vigencia</th>
                                <th class="col-estado">Estado</th>
                                <th class="col-acciones"></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var promocion in _promociones) {
                                <tr @key="promocion.Id">

                                    <td class="col-promocion">
                                        <span class="promo-nombre">@promocion.Nombre</span>

                                        @if (!string.IsNullOrWhiteSpace(promocion.Descripcion)) {
                                            <span class="promo-descripcion">@promocion.Descripcion</span>
                                        }
                                    </td>

                                    <td>@TipoTexto(promocion.Tipo)</td>

                                    <td>@Beneficio(promocion)</td>

                                    <td class="col-dias">@DiasTexto(promocion)</td>

                                    <td>
                                        <span class="promo-fecha">@promocion.FechaDesde.ToString("dd/MM/yyyy")</span>
                                        <span class="promo-fecha">@promocion.FechaHasta.ToString("dd/MM/yyyy")</span>
                                    </td>

                                    <td class="col-estado">
                                        <div class="admin-state-cell">
                                            <span class="admin-state @(promocion.Activa ? "programada" : "cancelada")">
                                                @(promocion.Activa ? "Activa" : "Inactiva")
                                            </span>
                                        </div>
                                    </td>

                                    <td class="col-acciones">
                                        <div class="admin-state-cell">

                                            <button type="button"
                                                    class="admin-row-action"
                                                    title="Editar"
                                                    @onclick="() => Editar(promocion)">
                                                <span class="material-icons">edit</span>
                                            </button>

                                            <button type="button"
                                                    class="admin-row-action"
                                                    title="@( promocion.Activa ? "Desactivar" : "Activar" )"
                                                    @onclick="() => CambiarEstado(promocion)">
                                                <span class="material-icons">
                                                    @( promocion.Activa ? "toggle_off" : "toggle_on" )
                                                </span>
                                            </button>

                                            <button type="button"
                                                    class="admin-row-action admin-row-action-danger"
                                                    title="Eliminar"
                                                    @onclick="() => Eliminar(promocion)">
                                                <span class="material-icons">delete</span>
                                            </button>

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </section>
    }

</div>
</AdminGuard>

@code {

    private IReadOnlyCollection<PromocionDto> _promociones = [];

    private bool _cargando = true;
    private bool _guardando;
    private string? _error;
    private string? _errorFormulario;

    private PromocionDto? _editando;

    private string _nombre = string.Empty;
    private Tipo _tipo = Tipo.NxM;
    private int _cantidadPagadas = 2;
    private int _cantidadGratis = 1;
    private decimal _porcentaje = 20m;
    private DateTime _fechaDesde = DateTime.Today;
    private DateTime _fechaHasta = DateTime.Today.AddMonths(1);
    private HashSet<DayOfWeek> _dias = [];

    private enum Tipo
    {
        NxM = 1,
        Porcentaje = 2
    }

    private static readonly (DayOfWeek Value,string Label)[] TodosLosDias =
    [
        (DayOfWeek.Monday,"Lun"),
        (DayOfWeek.Tuesday,"Mar"),
        (DayOfWeek.Wednesday,"Mié"),
        (DayOfWeek.Thursday,"Jue"),
        (DayOfWeek.Friday,"Vie"),
        (DayOfWeek.Saturday,"Sáb"),
        (DayOfWeek.Sunday,"Dom")
    ];

    // El índice coincide con DayOfWeek: 0 = Domingo.
    private static readonly string[] NombresDias =
    [
        "Domingo", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado"
    ];

    protected override async Task OnInitializedAsync()
    {
        await CargarPromociones();
    }

    private async Task CargarPromociones()
    {
        _cargando = true;
        _error = null;

        try {
            _promociones = await PromocionService.ObtenerTodasAsync();
        } catch {
            _error = "No se pudieron cargar las promociones.";
        } finally {
            _cargando = false;
        }
    }

    private void Editar(PromocionDto promocion)
    {
        _editando = promocion;

        _errorFormulario = null;

        _nombre = promocion.Nombre;
        _tipo = (Tipo)promocion.Tipo;
        _cantidadPagadas = promocion.CantidadPagadas ?? 2;
        _cantidadGratis = promocion.CantidadGratis ?? 1;
        _porcentaje = promocion.PorcentajeDescuento ?? 20m;
        _fechaDesde = promocion.FechaDesde.Date;
        _fechaHasta = promocion.FechaHasta.Date;

        _dias = promocion.DiasSemana
            .Select(dia => (DayOfWeek)dia)
            .ToHashSet();
    }

    private void LimpiarFormulario()
    {
        _editando = null;
        _errorFormulario = null;

        _nombre = string.Empty;
        _tipo = Tipo.NxM;
        _cantidadPagadas = 2;
        _cantidadGratis = 1;
        _porcentaje = 20m;
        _fechaDesde = DateTime.Today;
        _fechaHasta = DateTime.Today.AddMonths(1);
        _dias = [];
    }

    private void AlternarDia(DayOfWeek dia)
    {
        if (!_dias.Remove(dia))
            _dias.Add(dia);
    }

    private void CambiarFechaDesde(string? texto)
    {
        if (DateTime.TryParse(texto,out var fecha))
            _fechaDesde = fecha.Date;
    }

    private void CambiarFechaHasta(string? texto)
    {
        if (DateTime.TryParse(texto,out var fecha))
            _fechaHasta = fecha.Date;
    }

    private async Task Guardar()
    {
        _guardando = true;
        _errorFormulario = null;

        try {
            var dias = _dias.Select(dia => (int)dia).ToArray();

            (bool ok,string? error) resultado;

            if (_editando is null) {
                resultado = await PromocionService.CrearAsync(
                    new CrearPromocionRequest(
                        _nombre,
                        null,
                        (int)_tipo,
                        _tipo == Tipo.NxM ? _cantidadPagadas : null,
                        _tipo == Tipo.NxM ? _cantidadGratis : null,
                        _tipo == Tipo.Porcentaje ? _porcentaje : null,
                        _fechaDesde,
                        _fechaHasta,
                        dias));
            } else {
                resultado = await PromocionService.ActualizarAsync(
                    new ActualizarPromocionRequest(
                        _editando.Id,
                        _nombre,
                        null,
                        (int)_tipo,
                        _tipo == Tipo.NxM ? _cantidadPagadas : null,
                        _tipo == Tipo.NxM ? _cantidadGratis : null,
                        _tipo == Tipo.Porcentaje ? _porcentaje : null,
                        _fechaDesde,
                        _fechaHasta,
                        dias));
            }

            if (!resultado.ok) {
                _errorFormulario = ObtenerMensajeError(resultado.error);
                return;
            }

            LimpiarFormulario();

            await CargarPromociones();
        } finally {
            _guardando = false;
        }
    }

    private async Task CambiarEstado(PromocionDto promocion)
    {
        var (ok,error) = await PromocionService.CambiarEstadoAsync(
            promocion.Id,
            !promocion.Activa);

        if (!ok) {
            _error = ObtenerMensajeError(error);
            return;
        }

        await CargarPromociones();
    }

    private async Task Eliminar(PromocionDto promocion)
    {
        var (ok,error) = await PromocionService.EliminarAsync(promocion.Id);

        if (!ok) {
            _error = ObtenerMensajeError(error);
            return;
        }

        if (_editando?.Id == promocion.Id)
            LimpiarFormulario();

        await CargarPromociones();
    }

    private static string TipoTexto(int tipo) =>
        tipo == (int)Tipo.Porcentaje ? "Porcentaje" : "NxM";

    private static string Beneficio(PromocionDto promocion) =>
        promocion.Tipo == (int)Tipo.Porcentaje
            ? $"{promocion.PorcentajeDescuento:0.##}% de descuento"
            : $"{promocion.CantidadPagadas} pagadas + {promocion.CantidadGratis} gratis";

    private static string DiasTexto(PromocionDto promocion)
    {
        if (promocion.DiasSemana.Count == 7)
            return "Todos";

        var dias = promocion.DiasSemana
            .OrderBy(dia => dia)
            .Select(dia => NombresDias[dia]);

        return string.Join(", ",dias);
    }

    private static int ParsearEntero(object? valor) =>
        int.TryParse(valor?.ToString(),out var resultado) ? resultado : 0;

    private static decimal ParsearDecimal(object? valor) =>
        decimal.TryParse(valor?.ToString(),NumberStyles.Number,CultureInfo.InvariantCulture,out var resultado)
            ? resultado
            : 0m;

    private static string ObtenerMensajeError(string? respuesta)
    {
        if (string.IsNullOrWhiteSpace(respuesta))
            return "No se pudo guardar la promoción.";

        try {
            var problema = System.Text.Json.JsonSerializer.Deserialize<
                ApiProblemDetails>(respuesta);

            if (problema?.Errors is not null) {
                var mensajes = problema.Errors
                    .SelectMany(x => x.Value)
                    .Where(x => !string.IsNullOrWhiteSpace(x));

                if (mensajes.Any())
                    return string.Join(" ",mensajes);
            }

            return problema?.Detail ??
                problema?.Title ??
                "No se pudo guardar la promoción.";
        } catch {
            return "No se pudo guardar la promoción.";
        }
    }

    private sealed record ApiProblemDetails(
        string? Title,
        string? Detail,
        Dictionary<string, string[]>? Errors);

}
