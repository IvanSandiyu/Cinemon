@page "/admin/funciones/editar/{Id:int}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using Cinemon.Web.Models.DTOs
@using Cinemon.Web.Services

@inject FuncionApiService FuncionService
@inject PeliculaApiService PeliculaService
@inject SalaApiService SalaService
@inject NavigationManager Navigation

<PageTitle>Editar función | Admin | Cinemon</PageTitle>

<AdminGuard>
<div class="admin-page">

    <div class="admin-header">

        <span class="cinemon-kicker">
            Administración
        </span>

        <h1 class="admin-title">
            Editar función
        </h1>

        <p class="admin-subtitle">
            Modificá la película, la sala o el horario de la función.
        </p>

    </div>

    @if (_cargando) {
        <div class="d-flex justify-content-center py-5">
            <RadzenProgressBarCircular Indeterminate="true" />
        </div>
    } else if (_noEncontrada) {
        <section class="admin-form-section">
            <div class="admin-notfound">
                <span class="material-icons">search_off</span>

                <h2>@(_error is null ? "Función no encontrada" : "No se pudo cargar la función")</h2>

                <p>
                    @(_error ?? "La función que querés editar no existe o fue eliminada.")
                </p>

                <RadzenButton Text="Volver a funciones"
                              Icon="arrow_back"
                              Click="Cancelar"
                              class="admin-primary-button" />
            </div>
        </section>
    } else {

        <div class="admin-create-layout">

            <section class="admin-form-section">

                <div class="admin-form-section-header">

                    <div>
                        <h2>Datos de la función</h2>

                        <p>
                            Cambiá los datos y guardá los cambios.
                        </p>
                    </div>

                    <span class="admin-state @ObtenerClaseEstado(_funcion!.EstadoFuncion)">
                        @ObtenerNombreEstado(_funcion.EstadoFuncion)
                    </span>

                </div>

                @if (_soloProgramadas) {
                    <div class="admin-form-warning">
                        <span class="material-icons">info</span>

                        <span>
                            Solo se pueden editar funciones programadas.
                        </span>
                    </div>
                }

                <div class="admin-form">

                    <div class="admin-form-field">

                        <label>
                            Película
                        </label>

                        <select @bind="_peliculaId" disabled="@_soloProgramadas">
                            <option value="0">
                                Seleccionar película...
                            </option>

                            @foreach (var pelicula in _peliculas) {
                                <option value="@pelicula.Id">
                                    @pelicula.Titulo
                                    (@pelicula.ClasificacionEdad · @pelicula.Duracion min)
                                </option>
                            }
                        </select>

                        @if (_peliculaSeleccionada is not null) {
                            <span class="admin-field-hint">
                                El fin de la función se calculará con la duración de
                                @_peliculaSeleccionada.Duracion minutos.
                            </span>
                        }

                    </div>

                    <div class="admin-form-row">

                        <div class="admin-form-field">

                            <label>
                                Sala
                            </label>

                            <select @bind="_salaId" disabled="@_soloProgramadas">
                                <option value="0">
                                    Seleccionar sala...
                                </option>

                                @foreach (var sala in _salas) {
                                    <option value="@sala.Id">
                                        Sala @sala.Numero —
                                        @(sala.TipoSala == "Imax" ? "IMAX" : "Estándar")
                                        (@sala.CantidadButacas butacas)
                                    </option>
                                }
                            </select>

                        </div>

                        <div class="admin-form-field">

                            <label>
                                Fecha
                            </label>

                            <input type="date"
                                   @bind="_fecha"
                                   disabled="@_soloProgramadas" />

                        </div>

                        <div class="admin-form-field">

                            <label>
                                Hora
                            </label>

                            <input type="time"
                                   @bind="_hora"
                                   disabled="@_soloProgramadas" />

                        </div>

                    </div>

                    <div class="admin-form-row">

                        <div class="admin-form-field">

                            <label>
                                Precio por entrada ($)
                            </label>

                            <input type="number"
                                   min="1"
                                   step="0.01"
                                   @bind="_precio"
                                   disabled="@_soloProgramadas"
                                   placeholder="Ej: 6500" />

                        </div>

                        <div class="admin-form-field">

                            <label>
                                Idioma
                            </label>

                            <div class="admin-segmented">

                                <button type="button"
                                        class="@(_idioma == 1 ? "selected" : "")"
                                        disabled="@_soloProgramadas"
                                        @onclick="() => _idioma = 1">
                                    Español
                                </button>

                                <button type="button"
                                        class="@(_idioma == 2 ? "selected" : "")"
                                        disabled="@_soloProgramadas"
                                        @onclick="() => _idioma = 2">
                                    Subtitulada
                                </button>

                            </div>

                        </div>

                        <div class="admin-form-field">

                            <label>
                                Formato
                            </label>

                            <div class="admin-segmented">

                                <button type="button"
                                        class="@(_formato == 1 ? "selected" : "")"
                                        disabled="@_soloProgramadas"
                                        @onclick="() => _formato = 1">
                                    2D
                                </button>

                                <button type="button"
                                        class="@(_formato == 2 ? "selected" : "")"
                                        disabled="@_soloProgramadas"
                                        @onclick="() => _formato = 2">
                                    3D
                                </button>

                            </div>

                        </div>

                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(_error)) {
                    <div class="admin-form-error">
                        @_error
                    </div>
                }

                <div class="admin-form-actions">

                    <RadzenButton Text="Cancelar"
                                  Click="Cancelar"
                                  class="admin-cancel-button" />

                    <RadzenButton Text="Guardar cambios"
                                  Icon="save"
                                  Click="Guardar"
                                  Disabled="@(_guardando || _soloProgramadas)" />

                </div>

            </section>

        </div>

    }

</div>
</AdminGuard>

@code {

    [Parameter]
    public int Id { get; set; }

    private IReadOnlyCollection<PeliculaDto> _peliculas = [];
    private IReadOnlyCollection<SalaDto> _salas = [];

    private FuncionDto? _funcion;

    private bool _cargando = true;
    private bool _guardando;
    private bool _noEncontrada;

    private string? _error;

    private int _peliculaId;
    private int _salaId;
    private DateTime _fecha = DateTime.Today;
    private TimeOnly _hora = new(20, 0);
    private int _idioma = 1;
    private int _formato = 1;
    private decimal _precio;

    private bool _soloProgramadas =>
        _funcion?.EstadoFuncion != 1;

    private PeliculaDto? _peliculaSeleccionada =>
        _peliculas.FirstOrDefault(p => p.Id == _peliculaId);

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        _cargando = true;
        _error = null;

        try {
            var funciones = await FuncionService.ObtenerTodasAsync();

            _funcion = funciones.FirstOrDefault(f => f.Id == Id);

            if (_funcion is null) {
                _noEncontrada = true;
                return;
            }

            _peliculas = await PeliculaService.ObtenerTodasAsync();
            _salas = await SalaService.ObtenerTodasAsync();

            _peliculaId = _funcion.PeliculaId;
            _salaId = _funcion.SalaId;
            _fecha = _funcion.FechaHoraInicio.Date;
            _hora = TimeOnly.FromDateTime(_funcion.FechaHoraInicio);
            _idioma = _funcion.Idioma;
            _formato = _funcion.Formato;
            _precio = _funcion.Precio;
        } catch {
            _error = "No se pudieron cargar los datos de la función.";
            _noEncontrada = true;
        } finally {
            _cargando = false;
        }
    }

    private async Task Guardar()
    {
        _error = null;

        if (_peliculaId <= 0) {
            _error = "Seleccioná una película.";
            return;
        }

        if (_salaId <= 0) {
            _error = "Seleccioná una sala.";
            return;
        }

        var inicio = _fecha.Add(_hora.ToTimeSpan());

        if (inicio <= DateTime.Now) {
            _error = "La fecha y hora debe ser en el futuro.";
            return;
        }

        if (_precio <= 0) {
            _error = "El precio debe ser mayor a 0.";
            return;
        }

        var sala = _salas.FirstOrDefault(s => s.Id == _salaId);

        if (sala?.TipoSala == "Imax" && _formato == 2) {
            _error = "Una sala IMAX no puede tener funciones 3D.";
            return;
        }

        _guardando = true;

        try {
            var request = new FuncionDto(
                Id,
                _peliculaId,
                _salaId,
                inicio,
                _idioma,
                _formato,
                _precio,
                _funcion!.EstadoFuncion);

            var (ok, error) = await FuncionService.EditarAsync(Id, request);

            if (!ok) {
                _error = ObtenerMensajeError(error);
                return;
            }

            Navigation.NavigateTo("/admin/funciones");
        } catch (Exception) {
            _error = "No se pudo guardar la función.";
        } finally {
            _guardando = false;
        }
    }

    private string ObtenerMensajeError(string? respuesta)
    {
        if (string.IsNullOrWhiteSpace(respuesta))
            return "No se pudo guardar la función.";

        try {
            var problema = System.Text.Json.JsonSerializer.Deserialize<
                ApiProblemDetails>(respuesta);

            if (problema is null || problema.Errors is null)
                return problema?.Detail ??
                    problema?.Title ?? "No se pudo guardar la función.";

            var mensajes = problema.Errors
                .SelectMany(x => x.Value)
                .Where(x => !string.IsNullOrWhiteSpace(x));

            if (mensajes.Any()) {
                return string.Join(" ", mensajes);
            }
        } catch {
        }

        return "No se pudo guardar la función.";
    }

    private static string ObtenerNombreEstado(int estado)
    {
        return estado switch
        {
            1 => "Programada",
            2 => "Finalizada",
            3 => "Cancelada",
            _ => "Desconocido"
        };
    }

    private static string ObtenerClaseEstado(int estado)
    {
        return estado switch
        {
            1 => "programada",
            2 => "finalizada",
            3 => "cancelada",
            _ => ""
        };
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/admin/funciones");
    }

    private sealed record ApiProblemDetails(
        string? Title,
        string? Detail,
        Dictionary<string, string[]>? Errors);
}