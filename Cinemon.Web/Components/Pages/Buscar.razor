@page "/buscar"

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using Cinemon.Web.Models.DTOs
@using Cinemon.Web.Services
@inject PeliculaApiService PeliculaService

<PageTitle>Buscar películas | Cinemon</PageTitle>

<div class="buscar-head mt-4 mb-4 reveal">
    <h5 class="cinemon-kicker">Buscar películas</h5>
    <div class="buscar-input-wrapper mt-2">
        <RadzenIcon Icon="search" class="buscar-icon" />
        <input class="buscar-input"
               placeholder="Escribí el nombre de una película..."
               value="@_termino"
               @oninput="OnTerminoCambio"
               aria-label="Buscar películas" />
    </div>
</div>

@if (_cargando)
{
    <div class="d-flex justify-content-center mt-4">
        <RadzenProgressBarCircular Indeterminate="true" />
    </div>
}
else if (_resultados.Count == 0 && !string.IsNullOrWhiteSpace(_termino))
{
    <RadzenAlert AlertStyle="AlertStyle.Warning">
        No se encontraron películas que coincidan con "@_termino".
    </RadzenAlert>
}
else if (_resultados.Count == 0)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">
        No hay películas disponibles actualmente.
    </RadzenAlert>
}
else
{
    <div class="row g-3 justify-content-center">

        @foreach (var (pelicula, index) in _resultados.Select((p, i) => (p, i)))
        {
            <div class="col-6 col-sm-4 col-md-3 col-lg-3">
                <div class="cinemon-movie-card reveal"
                     style="@($"--reveal-delay: {Math.Min((index % 6) * 50, 200)}ms;")">

                    <div class="movie-poster-container"
                         @onclick="() => NavegarAPelicula(pelicula.Id)"
                         title="Ver funciones de @pelicula.Titulo">
                        <img class="movie-poster-img"
                             src="@(pelicula.TmdbPosterUrl ?? pelicula.PosterUrl)"
                             alt="@pelicula.Titulo"
                             loading="lazy" />
                    </div>

                    <div class="movie-info">
                        <h6 class="cinemon-card-title"
                            @onclick="() => NavegarAPelicula(pelicula.Id)"
                            style="cursor: pointer;">
                            @pelicula.Titulo
                        </h6>

                        <div class="movie-meta">
                            <span class="cinemon-genres">@(string.Join(" · ", pelicula.Generos))</span>
                            <span class="cinemon-divider"></span>
                            <span class="cinemon-duration">@pelicula.Duracion min</span>
                        </div>
                    </div>

                    <div class="movie-actions">
                        <RadzenLink Path="@($"/peliculas/{pelicula.Id}")"
                                    class="cinemon-link" TabIndex="-1">Ver funciones</RadzenLink>
                    </div>

                </div>
            </div>
        }

    </div>
}

@code {
    private IReadOnlyCollection<PeliculaDto> _peliculas = [];
    private IReadOnlyCollection<PeliculaDto> _resultados = [];
    private string _termino = "";
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _peliculas = await PeliculaService.ObtenerTodasAsync();
            _resultados = _peliculas
                .Where(p => p.Activa || p.FechaEstreno > DateTime.Today)
                .ToList();
        }
        finally
        {
            _cargando = false;
        }
    }

    private void OnTerminoCambio(ChangeEventArgs args)
    {
        _termino = args.Value?.ToString() ?? "";

        var termino = _termino.Trim();

        _resultados = string.IsNullOrWhiteSpace(termino)
            ? _peliculas
                .Where(p => p.Activa || p.FechaEstreno > DateTime.Today)
                .ToList()
            : _peliculas
                .Where(p => (p.Activa || p.FechaEstreno > DateTime.Today)
                            && p.Titulo.Contains(termino, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    private void NavegarAPelicula(int id) => Navigation.NavigateTo($"/peliculas/{id}");

    [Inject] private NavigationManager Navigation { get; set; } = default!;
}