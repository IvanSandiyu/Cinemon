@inherits LayoutComponentBase
@using Cinemon.Web.Services
@inject AuthService Auth
@inject NavigationManager Navigation

<div class="reloj-bar">
    <span id="fecha-hora" class="reloj-fecha-hora fw-semibold"></span>
</div>

<script src="/js/reloj.js"></script>

<div class="cinemon-shell">

    <header class="cinemon-header">
        <div class="appbar-inner">

            <BuscadorPeliculas />

            <a href="/"
               role="button"
               title="Ir al inicio"
               class="app-brand app-brand-pulse">
                CINEMON
            </a>

            <div class="appbar-account">
                <AccountArea />
            </div>

            <nav class="appbar-nav">
                <RadzenLink Path="/cartelera" Text="Cartelera" class="app-nav-link" />
                <RadzenLink Path="/proximos-estrenos" Text="Proximos estrenos" class="app-nav-link" />
                <RadzenLink Path="/candy" Text="Candy" class="app-nav-link" />
            </nav>

        </div>
    </header>

    <main class="cinemon-body">
        @Body
    </main>

    <footer class="cinemon-footer">
        <div class="footer-inner">

            <div class="footer-brand">
                <span class="footer-logo">CINEMON</span>
                <span class="footer-tagline">Tu cine, tu película.</span>
            </div>

            <nav class="footer-links" aria-label="Links del pie de página">
                <RadzenLink Path="/cartelera" Text="Cartelera" />
                <RadzenLink Path="/proximos-estrenos" Text="Proximos estrenos" />
                <RadzenLink Path="/candy" Text="Candy" />
                <RadzenLink Path="/buscar" Text="Buscar películas" />
            </nav>

            <div class="footer-contact">
                <span class="footer-contact-item">
                    <RadzenIcon Icon="place" />
                    <span>Av. Corrientes 1234, CABA</span>
                </span>
                <span class="footer-contact-item">
                    <RadzenIcon Icon="schedule" />
                    <span>Todos los días 10:00 - 23:00</span>
                </span>
            </div>

        </div>

        <div class="footer-bottom">
            <span>© @AnioActual Cinemon. Todos los derechos reservados.</span>
        </div>
    </footer>

</div>

@code {
    private static int AnioActual => DateTime.Now.Year;
}