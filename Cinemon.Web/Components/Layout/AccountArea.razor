@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@using Cinemon.Web.Services
@inject AuthService Auth
@inject NavigationManager Navigation

@if (!Auth.EstaAutenticado)
{
    <RadzenLink Path="/login" Icon="login" class="app-nav-link login-cta">Ingresar</RadzenLink>
}
else
{
    <div class="account-menu">
        <button type="button"
                class="account-trigger @(_menuAbierto ? "open" : "")"
                @onclick="AlternarMenu"
                aria-haspopup="true"
                aria-expanded="_menuAbierto"
                aria-label="Menú de cuenta">
            <span class="account-avatar">@Iniciales</span>
            <span class="account-name">@Auth.NombreApellido</span>
            <RadzenIcon Icon="@(_menuAbierto ? "arrow_drop_up" : "arrow_drop_down")" class="cinemon-account-caret" />
        </button>

        @if (_menuAbierto) {
            <div class="account-backdrop"
                 @onclick="CerrarMenu"
                 aria-hidden="true"></div>

            <div class="account-dropdown" role="menu">

                <div class="account-dropdown-header">
                    <span class="account-dropdown-avatar">@Iniciales</span>
                    <div class="account-dropdown-identity">
                        <strong>@Auth.NombreApellido</strong>
                        <span class="account-role-badge @(_esAdmin ? "admin" : "cliente")">
                            @(_esAdmin ? "Administrador" : "Cliente")
                        </span>
                    </div>
                </div>

                <div class="account-dropdown-body">
                    @if (_esAdmin) {
                        <button type="button"
                                class="account-dropdown-item"
                                role="menuitem"
                                @onclick="IrAlPanelAdmin">
                            <span class="account-item-icon">
                                <RadzenIcon Icon="admin_panel_settings" />
                            </span>
                            <span>Ir al panel de administrador</span>
                        </button>
                    } else {
                        <button type="button"
                                class="account-dropdown-item"
                                role="menuitem"
                                @onclick="IrAMiCuenta">
                            <span class="account-item-icon">
                                <RadzenIcon Icon="person" />
                            </span>
                            <span>Mi cuenta</span>
                        </button>

                        <button type="button"
                                class="account-dropdown-item"
                                role="menuitem"
                                @onclick="IrAMisCompras">
                            <span class="account-item-icon">
                                <RadzenIcon Icon="receipt_long" />
                            </span>
                            <span>Mis compras</span>
                        </button>
                    }
                </div>

                <div class="account-separator"></div>

                <button type="button"
                        class="account-dropdown-item danger"
                        role="menuitem"
                        @onclick="CerrarSesion">
                    <span class="account-item-icon">
                        <RadzenIcon Icon="logout" />
                    </span>
                    <span>Cerrar sesión</span>
                </button>

            </div>
        }
    </div>
}

@code {
    private bool _menuAbierto;

    private bool _esAdmin => Auth.Rol == 2;

    private string Iniciales => ObtenerIniciales(Auth.NombreApellido);

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await Auth.CargarAsync();
    }

    private async void OnLocationChanged(
        object? sender,
        Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await Auth.CargarAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void AlternarMenu()
    {
        _menuAbierto = !_menuAbierto;
    }

    private void CerrarMenu()
    {
        _menuAbierto = false;
    }

    private void IrA(string ruta)
    {
        _menuAbierto = false;
        Navigation.NavigateTo(ruta);
    }

    private void IrAlPanelAdmin()
    {
        IrA("/admin");
    }

    private void IrAMiCuenta()
    {
        IrA("/mi-cuenta");
    }

    private void IrAMisCompras()
    {
        IrA("/mis-compras");
    }

    private async Task CerrarSesion()
    {
        await Auth.LogoutAsync();
        _menuAbierto = false;
        Navigation.NavigateTo("/", forceLoad: false);
    }

    private static string ObtenerIniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "U";

        var partes = nombre
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        return string.Concat(partes
            .Take(2)
            .Select(p => char.ToUpperInvariant(p[0])));
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}