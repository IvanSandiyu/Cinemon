@using Cinemon.Web.Models.DTOs
@using Cinemon.Web.Services
@inject PeliculaApiService PeliculaService
@inject FavoritosService Favoritos

<div class="cartelera-seccion">

    <div class="cartelera-filtros">

        @foreach (var filtro in _filtros)
        {
            var f = filtro;
            <button type="button"
                    class="cartelera-filtro @(filtro == _filtroActual ? "activo" : "")"
                    @onclick="() => CambiarFiltro(f)">
                @EtiquetaDe(f)
            </button>
        }

    </div>

    @if (_cargando)
    {
        <div class="d-flex justify-content-center mt-4">
            <RadzenProgressBarCircular Indeterminate="true" />
        </div>
    }
    else if (PelículasVisibles.Count == 0)
    {
        <div class="cartelera-vacio">
            <RadzenAlert AlertStyle="AlertStyle.Info">
                @MensajeVacio
            </RadzenAlert>
        </div>
    }
    else
    {
        <div class="row g-2 cartelera-grid">

            @foreach (var (pelicula, index) in PelículasVisibles.Select((p, i) => (p, i)))
            {
                <div class="col-6 col-md-4">
                    <div class="cartelera-tarjeta reveal"
                         style="@($"--reveal-delay: {Math.Min((index % 6) * 50, 200)}ms;")">

                        <div class="cartelera-poster"
                             @onclick="() => NavegarAPelicula(pelicula.Id)"
                             title="Ver funciones de @pelicula.Titulo">

                            <img class="cartelera-poster-img"
                                 src="@(pelicula.TmdbPosterUrl ?? pelicula.PosterUrl)"
                                 alt="@pelicula.Titulo"
                                 loading="lazy" />

                            <button type="button"
                                    class="cartelera-btn-play"
                                    title="Ver trailer de @pelicula.Titulo"
                                    aria-label="Ver trailer">
                                <RadzenIcon Icon="play_arrow" />
                            </button>

                            <button type="button"
                                    class="cartelera-btn-favorito @(Favoritos.EsFavorito(pelicula.Id) ? "activo" : "")"
                                    @onclick="() => AlternarFavorito(pelicula.Id)"
                                    @onclick:stopPropagation="true"
                                    title="@(Favoritos.EsFavorito(pelicula.Id) ? "Quitar de mis películas" : "Marcar como favorita")"
                                    aria-label="Marcar película">
                                <RadzenIcon Icon="@(Favoritos.EsFavorito(pelicula.Id) ? "star" : "star_border")" />
                            </button>

                            <div class="cartelera-sombra"></div>

                            <div class="cartelera-info">
                                <div class="cartelera-texto">
                                    <h6 class="cartelera-titulo"
                                        @onclick="() => NavegarAPelicula(pelicula.Id)"
                                        style="cursor: pointer;">
                                        @pelicula.Titulo
                                    </h6>
                                    <div class="cartelera-clasificacion">@pelicula.ClasificacionEdad</div>
                                    <div class="cartelera-generos">@(string.Join(" · ", pelicula.Generos))</div>
                                </div>

                                <div class="cartelera-entradas-wrap">
                                    <RadzenLink Path="@($"/peliculas/{pelicula.Id}")"
                                                class="cartelera-entradas" TabIndex="-1">Entradas</RadzenLink>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>

@code {
    private enum FiltroCartelera
    {
        EnCartelera,
        Proximamente,
        Todo,
        MisPeliculas
    }

    private static readonly FiltroCartelera[] _filtros =
    [
        FiltroCartelera.EnCartelera,
        FiltroCartelera.Proximamente,
        FiltroCartelera.Todo,
        FiltroCartelera.MisPeliculas
    ];

    private IReadOnlyCollection<PeliculaDto> _peliculas = [];
    private bool _cargando = true;
    private FiltroCartelera _filtroActual = FiltroCartelera.EnCartelera;

    private IReadOnlyCollection<PeliculaDto> PelículasVisibles => _filtroActual switch
    {
        FiltroCartelera.EnCartelera => _peliculas
            .Where(p => p.Activa)
            .ToList(),
        FiltroCartelera.Proximamente => _peliculas
            .Where(p => p.FechaEstreno > DateTime.Today)
            .OrderBy(p => p.FechaEstreno)
            .ToList(),
        FiltroCartelera.Todo => _peliculas
            .ToList(),
        FiltroCartelera.MisPeliculas => _peliculas
            .Where(p => Favoritos.EsFavorito(p.Id))
            .ToList(),
        _ => []
    };

    private string MensajeVacio => _filtroActual switch
    {
        FiltroCartelera.EnCartelera => "No hay películas en cartelera actualmente.",
        FiltroCartelera.Proximamente => "No hay próximos estrenos cargados.",
        FiltroCartelera.MisPeliculas => "Todavía no marcaste ninguna película como favorita.",
        _ => "No hay películas disponibles."
    };

    private static string EtiquetaDe(FiltroCartelera filtro) => filtro switch
    {
        FiltroCartelera.EnCartelera => "En cartelera",
        FiltroCartelera.Proximamente => "Proximamente",
        FiltroCartelera.Todo => "Todo",
        FiltroCartelera.MisPeliculas => "Mis peliculas",
        _ => "?"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Favoritos.CargarAsync();
            _peliculas = await PeliculaService.ObtenerTodasAsync();
        }
        finally
        {
            _cargando = false;
        }
    }

    private void CambiarFiltro(FiltroCartelera filtro)
    {
        _filtroActual = filtro;
    }

    private async Task AlternarFavorito(int id)
    {
        await Favoritos.AlternarAsync(id);
    }

    private void NavegarAPelicula(int id) => Navigation.NavigateTo($"/peliculas/{id}");

    [Inject] private NavigationManager Navigation { get; set; } = default!;
}