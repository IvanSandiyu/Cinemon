@using Cinemon.Web.Models.DTOs
@using Cinemon.Web.Services
@inject PeliculaApiService PeliculaService
@inject FavoritosService Favoritos
@inject IJSRuntime JS

<div class="cartelera-seccion" @ref="_seccionRef">

    <div class="cartelera-filtros">

        @foreach (var filtro in _filtros)
        {
            var f = filtro;
            <button type="button"
                    class="cartelera-filtro @(filtro == _filtroActual ? "activo" : "")"
                    @onclick="() => CambiarFiltro(f)">
                @EtiquetaDe(f)
            </button>
        }

    </div>

    @if (_cargando)
    {
        <div class="d-flex justify-content-center mt-4">
            <LogoLoader />
        </div>
    }
    else if (_error is not null)
    {
        <div class="cartelera-vacio">
            <RadzenAlert AlertStyle="AlertStyle.Danger">
                @_error
            </RadzenAlert>

            <RadzenButton Text="Reintentar"
                          Icon="refresh"
                          Click="CargarPaginaAsync"
                          ButtonStyle="ButtonStyle.Secondary" />
        </div>
    }
    else if (_peliculas.Count == 0)
    {
        <div class="cartelera-vacio">
            <RadzenAlert AlertStyle="AlertStyle.Info">
                @MensajeVacio
            </RadzenAlert>
        </div>
    }
    else
    {
        <div class="row g-2 cartelera-grid">

            @foreach (var (pelicula, index) in _peliculas.Select((p, i) => (p, i)))
            {
                var posterUrl = pelicula.TmdbPosterUrl ?? pelicula.PosterUrl;

                <div class="col-6 col-md-3">
                    <div class="cartelera-tarjeta reveal"
                         style="@($"--reveal-delay: {Math.Min((index % 6) * 50, 200)}ms;")">

                        <div class="cartelera-poster"
                             @onclick="() => NavegarAPelicula(pelicula.Id)"
                             title="Ver funciones de @pelicula.Titulo">

                            <img class="cartelera-poster-img"
                                 src="@posterUrl"
                                 alt="@pelicula.Titulo"
                                 loading="lazy" />

                            <button type="button"
                                    class="cartelera-btn-play"
                                    title="Ver trailer de @pelicula.Titulo"
                                    aria-label="Ver trailer de @pelicula.Titulo"
                                    @onclick="() => AbrirTrailer(pelicula.TrailerUrl)"
                                    @onclick:stopPropagation="true">
                                <RadzenIcon Icon="play_arrow" />
                            </button>

                            <button type="button"
                                    class="cartelera-btn-favorito @(Favoritos.EsFavorito(pelicula.Id) ? "activo" : "")"
                                    @onclick="() => AlternarFavorito(pelicula.Id)"
                                    @onclick:stopPropagation="true"
                                    title="@(Favoritos.EsFavorito(pelicula.Id) ? "Quitar de mis películas" : "Marcar como favorita")"
                                    aria-label="Marcar película">
                                <RadzenIcon Icon="@(Favoritos.EsFavorito(pelicula.Id) ? "star" : "star_border")" />
                            </button>

                            <div class="cartelera-sombra"></div>

                            <div class="cartelera-info">
                                <div class="cartelera-texto">
                                    <h6 class="cartelera-titulo"
                                        @onclick="() => NavegarAPelicula(pelicula.Id)"
                                        style="cursor: pointer;">
                                        @pelicula.Titulo
                                    </h6>
                                    <div class="cartelera-clasificacion">@pelicula.ClasificacionEdad</div>
                                    <div class="cartelera-generos">@(string.Join(" · ", pelicula.Generos))</div>
                                </div>

                                <div class="cartelera-entradas-wrap">
                                    <RadzenLink Path="@($"/peliculas/{pelicula.Id}")"
                                                class="cartelera-entradas" TabIndex="-1">Entradas</RadzenLink>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>

        <Paginador PaginaActual="_paginaActual"
                   TotalPaginas="_totalPaginas"
                   PaginaCambiada="CambiarPagina"
                   AriaLabel="Paginación de cartelera" />

        @if (mostrarTrailer) {
            <div class="trailer-overlay"
                 @onclick="CerrarTrailer"
                 @onkeydown="CerrarConTecla"
                 tabindex="0"
                 @ref="_overlayRef">
                <div class="trailer-modal" @onclick:stopPropagation="true">

                    <button class="trailer-close"
                            @onclick="CerrarTrailer"
                            aria-label="Cerrar tráiler">
                        &times;
                    </button>

                    <div class="trailer-player">
                        <iframe src="@UrlTrailerEmbed"
                                title="Tráiler de la película"
                                allow="autoplay; encrypted-media; picture-in-picture"
                                allowfullscreen>
                        </iframe>
                    </div>

                </div>
            </div>
        }
    }

</div>

@code {
    private enum FiltroCartelera
    {
        EnCartelera,
        Proximamente,
        Todo,
        MisPeliculas
    }

    private static readonly FiltroCartelera[] _filtros =
    [
        FiltroCartelera.EnCartelera,
        FiltroCartelera.Proximamente,
        FiltroCartelera.Todo,
        FiltroCartelera.MisPeliculas
    ];

    private IReadOnlyCollection<PeliculaDto> _peliculas = [];
    private bool _cargando = true;
    private string? _error;
    private FiltroCartelera _filtroActual = FiltroCartelera.EnCartelera;
    private const int TamanoPagina = 9;
    private int _paginaActual = 1;
    private int _totalPaginas = 1;
    private ElementReference _seccionRef;
    private CancellationTokenSource? _cts;

    private string MensajeVacio => _filtroActual switch
    {
        FiltroCartelera.EnCartelera => "No hay películas en cartelera actualmente.",
        FiltroCartelera.Proximamente => "No hay próximos estrenos cargados.",
        FiltroCartelera.MisPeliculas => "Todavía no marcaste ninguna película como favorita.",
        _ => "No hay películas disponibles."
    };

    private static string EtiquetaDe(FiltroCartelera filtro) => filtro switch
    {
        FiltroCartelera.EnCartelera => "En cartelera",
        FiltroCartelera.Proximamente => "Proximamente",
        FiltroCartelera.Todo => "Todo",
        FiltroCartelera.MisPeliculas => "Mis peliculas",
        _ => "?"
    };

    protected override async Task OnInitializedAsync()
    {
        await Favoritos.CargarAsync();
        await CargarPaginaAsync();
    }

    private async Task CargarPaginaAsync()
    {
        _cts?.Cancel();

        var cts = new CancellationTokenSource();
        _cts = cts;

        _cargando = true;
        _error = null;

        try
        {
            var ids = _filtroActual == FiltroCartelera.MisPeliculas
                ? Favoritos.ObtenerIds()
                : null;

            var resultado = await PeliculaService.ObtenerPaginadasAsync(
                _paginaActual,
                TamanoPagina,
                _filtroActual.ToString(),
                ids: ids,
                cancellationToken: cts.Token);

            if (cts.IsCancellationRequested)
                return;

            _peliculas = resultado.Items;
            _totalPaginas = Math.Max(1, resultado.TotalPaginas);
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            if (!cts.IsCancellationRequested)
            {
                _peliculas = [];
                _totalPaginas = 1;
                _error = "No se pudieron cargar las películas. Revisá que el servicio de la API esté disponible.";
            }
        }
        finally
        {
            if (ReferenceEquals(_cts, cts))
            {
                _cargando = false;
                _cts = null;
            }

            cts.Dispose();
        }
    }

    private async Task CambiarFiltro(FiltroCartelera filtro)
    {
        _filtroActual = filtro;
        _paginaActual = 1;
        await CargarPaginaAsync();
    }

    private async Task AlternarFavorito(int id)
    {
        await Favoritos.AlternarAsync(id);

        if (_filtroActual != FiltroCartelera.MisPeliculas)
            return;

        await CargarPaginaAsync();

        if (_paginaActual > _totalPaginas)
        {
            _paginaActual = _totalPaginas;
            await CargarPaginaAsync();
        }
    }

    private async Task CambiarPagina(int pagina)
    {
        _paginaActual = pagina;
        await CargarPaginaAsync();
        await JS.InvokeVoidAsync("cinemonScrollIntoView", _seccionRef);
    }

    private void NavegarAPelicula(int id) => Navigation.NavigateTo($"/peliculas/{id}");

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool mostrarTrailer;
    private string? UrlTrailerEmbed;
    private ElementReference _overlayRef;
    private bool _pedirFocoOverlay;

    private void AbrirTrailer(string? trailer)
    {
        if (string.IsNullOrWhiteSpace(trailer))
            return;

        var videoId = ObtenerVideoId(trailer);

        if (string.IsNullOrWhiteSpace(videoId))
            return;

        UrlTrailerEmbed =
            $"https://www.youtube-nocookie.com/embed/{videoId}?autoplay=1";
        mostrarTrailer = true;
        _pedirFocoOverlay = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pedirFocoOverlay) {
            _pedirFocoOverlay = false;
            await _overlayRef.FocusAsync(false);
        }
    }

    private void CerrarConTecla(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CerrarTrailer();
    }

    private static string? ObtenerVideoId(string url)
    {
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri))
            return null;

        if (uri.Host.Equals("youtu.be", StringComparison.OrdinalIgnoreCase))
            return uri.AbsolutePath.Trim('/');

        if (uri.Host.Equals("www.youtube.com", StringComparison.OrdinalIgnoreCase) ||
            uri.Host.Equals("youtube.com", StringComparison.OrdinalIgnoreCase) ||
            uri.Host.Equals("www.youtube-nocookie.com", StringComparison.OrdinalIgnoreCase)) {
            if (uri.AbsolutePath == "/watch")
                return Microsoft.AspNetCore.WebUtilities
                    .QueryHelpers.ParseQuery(uri.Query)["v"].ToString();

            if (uri.AbsolutePath.StartsWith("/embed/") ||
                uri.AbsolutePath.StartsWith("/shorts/")) {
                return uri.AbsolutePath
                    .Split('/', StringSplitOptions.RemoveEmptyEntries)
                    .LastOrDefault();
            }
        }

        return null;
    }

    private void CerrarTrailer()
    {
        mostrarTrailer = false;
        UrlTrailerEmbed = null;
    }

}