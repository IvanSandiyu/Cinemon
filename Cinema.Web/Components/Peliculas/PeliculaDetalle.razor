@page "/peliculas/{Id:int}"
@using Cinemon.Web.Models.DTOs
@using Cinemon.Web.Services
@inject PeliculaApiService PeliculaService
@inject NavigationManager Navigation

<PageTitle>
    @(_pelicula?.Titulo ?? "Película") | Cinemon
</PageTitle>

@if (_cargando) {
    <div class="d-flex justify-center mt-10">
        <MudProgressCircular Color="Color.Primary"
                             Size="Size.Large"
                             Indeterminate="true" />
    </div>
} else if (_pelicula is null) {
    <MudAlert Severity="Severity.Error">
        No se encontró la película.
    </MudAlert>
} else {
    <MudGrid>

        <MudItem xs="12" md="4">
            <MudCard>
                <MudCardMedia Image="@_pelicula.PosterUrl"
                              Height="550"
                              Alt="@_pelicula.Titulo" />
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="8">

            <MudText Typo="Typo.h2">
                @_pelicula.Titulo
            </MudText>

            <MudStack Row="true" Spacing="1" Class="mt-3 mb-4">

                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Outlined">
                    @_pelicula.ClasificacionEdad
                </MudChip>

                @foreach (var genero in _pelicula.Generos) {
                    <MudChip T="string"
                             Size="Size.Small"
                             Variant="Variant.Outlined">
                        @genero
                    </MudChip>
                }

            </MudStack>

            <MudText Typo="Typo.body1" Class="mb-4">
                @_pelicula.Sinopsis
            </MudText>

            <MudStack Spacing="2">

                <MudText Typo="Typo.body2">
                    <strong>Duración:</strong>
                    @_pelicula.Duracion minutos
                </MudText>

                <MudText Typo="Typo.body2">
                    <strong>Estreno:</strong>
                    @_pelicula.FechaEstreno.ToString("dd/MM/yyyy")
                </MudText>

            </MudStack>

            @if (_pelicula.Activa) {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Class="mt-6"
                           OnClick="VerFunciones">

                    Ver funciones

                </MudButton>
            } else {
                <MudAlert Severity="Severity.Info"
                          Class="mt-6">

                    Esta película todavía no se encuentra disponible.

                </MudAlert>
            }

        </MudItem>

    </MudGrid>

    @if (!string.IsNullOrWhiteSpace(_pelicula.TrailerUrl)) {
        <MudDivider Class="my-8" />

        <MudText Typo="Typo.h4" Class="mb-4">
            Trailer
        </MudText>

        <MudPaper Class="pa-2">
            <iframe width="100%"
                    height="500"
                    src="@_pelicula.TrailerUrl"
                    title="Trailer de @_pelicula.Titulo"
                    frameborder="0"
                    allowfullscreen>
            </iframe>
        </MudPaper>
    }
}

@code {

    [Parameter]
    public int Id { get; set; }

    private PeliculaDto? _pelicula;
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try {
            _pelicula = await PeliculaService.ObtenerPorIdAsync(Id);
        } finally {
            _cargando = false;
        }
    }

    private void VerFunciones()
    {
        Navigation.NavigateTo($"/peliculas/{Id}/funciones");
    }
}