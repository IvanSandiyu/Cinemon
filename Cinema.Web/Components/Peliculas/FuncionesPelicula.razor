@page "/peliculas/{PeliculaId:int}/funciones"
@using Cinemon.Web.Models.DTOs
@using Cinemon.Web.Services

@inject FuncionApiService FuncionService
@inject PeliculaApiService PeliculaService
@inject NavigationManager Navigation

<PageTitle>Funciones | Cinemon</PageTitle>

@if (_cargando) {
    <div class="d-flex justify-center mt-10">
        <MudProgressCircular Color="Color.Primary"
                             Size="Size.Large"
                             Indeterminate="true" />
    </div>
} else if (_pelicula is null) {
    <MudAlert Severity="Severity.Error">
        No se encontró la película.
    </MudAlert>
} else {
    <MudText Typo="Typo.h3">
        @_pelicula.Titulo
    </MudText>

    <MudText Typo="Typo.body1"
             Color="Color.Secondary"
             Class="mb-6">
        Seleccioná una función
    </MudText>

    @if (_funciones.Count == 0) {
        <MudAlert Severity="Severity.Info">
            No hay funciones disponibles para esta película.
        </MudAlert>
    } else {
        @foreach (var grupo in
                    _funciones
                        .GroupBy(x => x.FechaHoraInicio.Date)
                        .OrderBy(x => x.Key)) {
            <MudText Typo="Typo.h5" Class="mt-6 mb-3">
                @grupo.Key.ToString("dddd dd/MM")
            </MudText>

            <MudGrid>

                @foreach (var funcion in grupo.OrderBy(x => x.FechaHoraInicio)) {
                    <MudItem xs="12" sm="6" md="4">

                        <MudCard Class="pa-2">

                            <MudCardContent>

                                <MudText Typo="Typo.h5">
                                    @funcion.FechaHoraInicio.ToString("HH:mm")
                                </MudText>

                                <MudText Typo="Typo.body2">
                                    Sala @funcion.SalaId
                                </MudText>

                                <MudText Typo="Typo.body2">
                                    @ObtenerIdioma(funcion.Idioma)
                                    ·
                                    @ObtenerFormato(funcion.Formato)
                                </MudText>

                                <MudText Typo="Typo.body1"
                                         Class="mt-2">
                                    @funcion.Precio.ToString("C")
                                </MudText>

                            </MudCardContent>

                            <MudCardActions>

                                @if (funcion.EstadoFuncion == 1) {
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               FullWidth="true"
                                               OnClick="@(() => SeleccionarFuncion(funcion))">

                                        Comprar entradas

                                    </MudButton>
                                } else {
                                    <MudButton Variant="Variant.Outlined"
                                               Disabled="true"
                                               FullWidth="true">

                                        @ObtenerEstado(funcion.EstadoFuncion)

                                    </MudButton>
                                }

                            </MudCardActions>

                        </MudCard>

                    </MudItem>
                }

            </MudGrid>
        }
    }
}

@code {

    [Parameter]
    public int PeliculaId { get; set; }

    private PeliculaDto? _pelicula;
    private IReadOnlyCollection<FuncionDto> _funciones = [];
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try {
            _pelicula = await PeliculaService
                .ObtenerPorIdAsync(PeliculaId);

            var funciones = await FuncionService
                .ObtenerTodasAsync();

            _funciones = funciones
                .Where(x => x.PeliculaId == PeliculaId)
                .ToList();
        } finally {
            _cargando = false;
        }
    }

    private void SeleccionarFuncion(FuncionDto funcion)
    {
        Navigation.NavigateTo(
            $"/funciones/{funcion.Id}/butacas");
    }

    private static string ObtenerIdioma(int idioma)
    {
        return idioma switch
        {
            1 => "Español",
            2 => "Sub",
            _ => "Desconocido"
        };
    }

    private static string ObtenerFormato(int formato)
    {
        return formato switch
        {
            1 => "2D",
            2 => "3D",
            _ => "Desconocido"
        };
    }

    private static string ObtenerEstado(int estado)
    {
        return estado switch
        {
            1 => "Programada",
            2 => "Finalizada",
            3 => "Cancelada",
            _ => "Desconocido"
        };
    }
}