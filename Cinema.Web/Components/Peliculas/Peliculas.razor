@page "/peliculas"
@using Cinemon.Web.Models.DTOs
@using Cinemon.Web.Services
@inject PeliculaApiService PeliculaService

<PageTitle>Cartelera | Cinemon</PageTitle>

<MudText Typo="Typo.h3" Class="mb-2">
    Cartelera
</MudText>

<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
    Descubrí las películas disponibles en Cinemon.
</MudText>

@if (_cargando)
{
    <div class="d-flex justify-center mt-10">
        <MudProgressCircular
            Color="Color.Primary"
            Size="Size.Large"
            Indeterminate="true" />
    </div>
}
else if (_peliculas.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        No hay películas disponibles actualmente.
    </MudAlert>
}
else
{
    <MudGrid>

        @foreach (var pelicula in _peliculas)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">

                <MudCard Class="h-100">

                    <MudCardMedia
                        Image="@pelicula.PosterUrl"
                        Height="420"
                        Alt="@pelicula.Titulo" />

                    <MudCardContent>

                        <MudText
                            Typo="Typo.h6"
                            Class="mb-2">
                            @pelicula.Titulo
                        </MudText>

                        <MudStack
                            Row="true"
                            Spacing="1"
                            Class="mb-3">

                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Outlined">
                                @pelicula.ClasificacionEdad
                            </MudChip>

                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Outlined">
                                @pelicula.ClasificacionEdad
                            </MudChip>

                        </MudStack>

                        <MudText
                            Typo="Typo.body2"
                            Color="Color.Secondary">
                            @pelicula.Duracion minutos
                        </MudText>

                    </MudCardContent>

                    <MudCardActions>

                        <MudButton
                            Variant="Variant.Filled"
                            Color="Color.Primary"
                            FullWidth="true"
                            Href="@($"/peliculas/{pelicula.Id}")">
                            Ver película
                        </MudButton>

                    </MudCardActions>

                </MudCard>

            </MudItem>
        }

    </MudGrid>
}

@code {

    private IReadOnlyCollection<PeliculaDto> _peliculas = [];
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _peliculas = await PeliculaService.ObtenerTodasAsync();
        }
        finally
        {
            _cargando = false;
        }
    }
}