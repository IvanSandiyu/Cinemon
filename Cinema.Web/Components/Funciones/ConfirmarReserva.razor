@page "/funciones/{FuncionId:int}/confirmar"

@using Cinemon.Web.Models.DTOs
@using Cinemon.Web.Models.DTOs.Requests
@using Cinemon.Web.Services
@using Microsoft.AspNetCore.WebUtilities

@inject FuncionApiService FuncionService
@inject PeliculaApiService PeliculaService
@inject ReservaApiService ReservaService
@inject NavigationManager Navigation

<PageTitle>Confirmar reserva | Cinemon</PageTitle>

@if (_cargando) {
    <div class="d-flex justify-center mt-10">
        <MudProgressCircular Color="Color.Primary"
                             Size="Size.Large"
                             Indeterminate="true" />
    </div>
} else if (_funcion is null || _pelicula is null) {
    <MudAlert Severity="Severity.Error">
        No se pudo obtener la información de la función.
    </MudAlert>
} else {
    <MudText Typo="Typo.h3" Class="mb-6">
        Confirmar reserva
    </MudText>

    <MudGrid>

        <MudItem xs="12" md="7">

            <MudCard>

                <MudCardContent>

                    <MudText Typo="Typo.h5">
                        @_pelicula.Titulo
                    </MudText>

                    <MudText Typo="Typo.body1"
                             Color="Color.Secondary"
                             Class="mt-2">

                        @_funcion.FechaHoraInicio.ToString(
                        "dddd dd/MM/yyyy - HH:mm")

                </MudText>

                <MudText Typo="Typo.body2"
                         Class="mt-1">

                    Sala @_funcion.SalaId

                </MudText>

            </MudCardContent>

        </MudCard>

        <MudCard Class="mt-4">

            <MudCardContent>

                <MudText Typo="Typo.h6" Class="mb-3">
                    Butacas seleccionadas
                </MudText>

                <MudStack Row="true" Spacing="1">

                    @foreach (var butaca in _butacasSeleccionadas) {
                            <MudChip T="string"
                                     Color="Color.Primary">
                                @butaca
                            </MudChip>
                        }

                    </MudStack>

                </MudCardContent>

            </MudCard>

        </MudItem>

        <MudItem xs="12" md="5">

            <MudCard>

                <MudCardContent>

                    <MudText Typo="Typo.h6">
                        Resumen
                    </MudText>

                    <MudDivider Class="my-4" />

                    <MudStack Spacing="2">

                        <MudStack Row="true">
                            <MudText>
                                Precio por entrada
                            </MudText>

                            <MudSpacer />

                            <MudText>
                                @_funcion.Precio.ToString("C")
                            </MudText>
                        </MudStack>

                        <MudStack Row="true">
                            <MudText>
                                Cantidad
                            </MudText>

                            <MudSpacer />

                            <MudText>
                                @_butacasSeleccionadas.Count
                            </MudText>
                        </MudStack>

                        <MudDivider />

                        <MudStack Row="true">

                            <MudText Typo="Typo.h6">
                                Total
                            </MudText>

                            <MudSpacer />

                            <MudText Typo="Typo.h6">
                                @Total.ToString("C")
                            </MudText>

                        </MudStack>

                    </MudStack>

                </MudCardContent>

                <MudCardActions>

                    <MudButton Variant="Variant.Outlined"
                               FullWidth="true"
                               OnClick="Volver">

                        Volver

                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Disabled="_procesando"
                               OnClick="Confirmar">

                        @if (_procesando) {
                            <MudProgressCircular Size="Size.Small"
                                                 Indeterminate="true" />
                        } else {
                            <span>Confirmar compra</span>
                        }

                    </MudButton>

                </MudCardActions>

            </MudCard>

        </MudItem>

    </MudGrid>

    @if (!string.IsNullOrWhiteSpace(_error)) {
        <MudAlert Severity="Severity.Error"
                  Class="mt-4">

            @_error

        </MudAlert>
    }
}

@code {

    [Parameter]
    public int FuncionId { get; set; }

    private FuncionDto? _funcion;
    private PeliculaDto? _pelicula;

    private List<int> _butacasSeleccionadas = [];

    private bool _cargando = true;
    private bool _procesando;
    private string? _error;

    private decimal Total =>
        (_funcion?.Precio ?? 0) *
        _butacasSeleccionadas.Count;

    protected override async Task OnInitializedAsync()
    {
        try {
            var uri = Navigation.ToAbsoluteUri(
                Navigation.Uri);

            if (QueryHelpers.ParseQuery(uri.Query)
                .TryGetValue("butacas", out var value)) {
                _butacasSeleccionadas = value
                    .ToString()
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(int.Parse)
                    .ToList();
            }

            var funciones =
                await FuncionService.ObtenerTodasAsync();

            _funcion = funciones
                .FirstOrDefault(x => x.Id == FuncionId);

            if (_funcion is not null) {
                _pelicula = await PeliculaService
                    .ObtenerPorIdAsync(_funcion.PeliculaId);
            }
        } finally {
            _cargando = false;
        }
    }

    private async Task Confirmar()
    {
        _procesando = true;
        _error = null;

        try {
            // Temporalmente utilizamos el usuario 1.
            // Después lo reemplazamos por el usuario
            // autenticado mediante JWT.

            var request = new CrearReservaRequest(
                UsuarioId: 1,
                RealizadaPorId: 1,
                FuncionId: FuncionId,
                ButacasIds: _butacasSeleccionadas);

            var response = await ReservaService.CrearAsync(request);

            if (response.IsSuccessStatusCode) {
                Navigation.NavigateTo("/reserva-confirmada");
                return;
            }

            if (response.StatusCode ==
                System.Net.HttpStatusCode.Unauthorized) {
                _error = "Debés iniciar sesión para comprar entradas.";
                return;
            }

            if (response.StatusCode ==
                System.Net.HttpStatusCode.BadRequest) {
                _error =
                    "No se pudo realizar la reserva. " +
                    "Una o más butacas podrían haber sido reservadas.";
                return;
            }

            _error = "Ocurrió un error al realizar la reserva.";
        } catch {
            _error =
                "No se pudo conectar con el servidor.";
        } finally {
            _procesando = false;
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo(
            $"/funciones/{FuncionId}/butacas");
    }
}