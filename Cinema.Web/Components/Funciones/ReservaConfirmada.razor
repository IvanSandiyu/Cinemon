@page "/reserva-confirmada"

@inject NavigationManager Navigation

<PageTitle>Reserva confirmada | Cinemon</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-12">

    <MudCard Class="pa-8">

        <MudCardContent>

            <MudStack AlignItems="AlignItems.Center"
                      Spacing="3">

                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                         Color="Color.Success"
                         Size="Size.Large" />

                <MudText Typo="Typo.h4"
                         Align="Align.Center">

                    ¡Reserva confirmada!

                </MudText>

                <MudText Typo="Typo.body1"
                         Align="Align.Center"
                         Color="Color.Secondary">

                    Tu compra fue realizada correctamente.
                </MudText>

            </MudStack>

        </MudCardContent>

        <MudCardActions>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       OnClick="VolverInicio">

                Volver al inicio

            </MudButton>

        </MudCardActions>

    </MudCard>

</MudContainer>

@code {

    private void VolverInicio()
    {
        Navigation.NavigateTo("/");
    }

}